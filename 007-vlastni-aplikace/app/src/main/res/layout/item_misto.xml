<?xml version="1.0" encoding="utf-8"?>
<!-- Jedna karta v seznamu zastavení -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/karta"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgMisto"
            android:layout_width="104dp"
            android:layout_height="88dp"
            android:contentDescription="@string/popis_obrazku"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/txtNazev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/inkoust"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLokalita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/les"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="14dp"
            android:text="›"
            android:textColor="@color/inkoust_svetly"
            android:textSize="28sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
