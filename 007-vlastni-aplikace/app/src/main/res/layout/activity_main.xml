<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pergamen"
    tools:context=".MainActivity">

    <!-- Horní lišta s názvem aplikace -->
    <TextView
        android:id="@+id/txtHlavicka"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/les"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:text="@string/hlavicka"
        android:textColor="@color/pergamen"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sem se střídají fragmenty (stejně jako v MyApp007aFragments) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtHlavicka" />

    <!-- Dolní navigace místo dvou tlačítek -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/karta"
        app:itemIconTint="@color/nav_barva"
        app:itemTextColor="@color/nav_barva"
        app:itemActiveIndicatorStyle="@style/IndikatorNavigace"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
