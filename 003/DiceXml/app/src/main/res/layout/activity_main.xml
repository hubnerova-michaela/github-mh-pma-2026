<?xml version="1.0" encoding="utf-8"?>
<!-- Hlavní kontejner: mátové pozadí, obsah vystředěný -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint_background"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Nadpis v rukopisném písmu -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="cursive"
        android:text="🌿 Hoď kostkou 🌿"
        android:textColor="@color/deep_green"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Karta s kostkou -->
    <LinearLayout
        android:id="@+id/llDiceCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_dice_card"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:clipToPadding="false">

        <!-- Symbol kostky: čtvercový prvek s rezervou, aby se při otáčení neořezával -->
        <TextView
            android:id="@+id/tvDice"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:padding="16dp"
            android:text="⚀"
            android:textColor="@color/deep_green"
            android:textSize="140sp" />
    </LinearLayout>

    <!-- Tlačítko pro hod -->
    <Button
        android:id="@+id/btnRoll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/button_tint"
        android:paddingHorizontal="40dp"
        android:text="Hodit 🌱"
        android:textColor="@color/deep_green"
        android:textSize="20sp"
        app:cornerRadius="28dp" />

    <!-- Dekorace -->
    <TextView
        android:id="@+id/tvPlants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="🪴 🌱 🌿 🌱 🪴"
        android:textSize="28sp" />
</LinearLayout>